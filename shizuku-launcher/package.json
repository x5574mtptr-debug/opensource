{
  "name": "shizuku-launcher",
  "version": "1.0.0",
  "description": "Shizuku 激活工具 - Windows 桌面版",
  "main": "src/main/main.js",
  "author": "WorkBuddy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --dev",
    "test": "node test/core.test.js",
    "icon": "node scripts/make-icon.js",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.workbuddy.shizuku.launcher",
    "productName": "Shizuku 激活工具",
    "copyright": "Copyright © 2026 WorkBuddy",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shizuku 激活工具",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "asarUnpack": [
      "**/resources/platform-tools/**"
    ]
  }
}
