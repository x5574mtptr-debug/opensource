<script>
import battery from '@system.battery'
import bright from '@system.brightness'

export default {
  onCreate() {
    console.log('[BandTester] App created')
    // 预检查可用功能
    battery.getStatus({
      success: (data) => {
        console.log('[BandTester] Battery supported:', data.level)
        this.$app.$data._batteryOk = true
      },
      fail: () => {
        this.$app.$data._batteryOk = false
      }
    })
    bright.getValue({
      success: (data) => {
        console.log('[BandTester] Brightness:', data.value)
        this.$app.$data._brightOk = true
      },
      fail: () => {
        this.$app.$data._brightOk = false
      }
    })
    this.$app.$data._appReady = true
  },
  onDestroy() {
    console.log('[BandTester] App destroyed')
  }
}
</script>
