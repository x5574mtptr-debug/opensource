<template>
  <div class="page">
    <text class="page-title">{{ $t("test.bluetooth") }}</text>
    
    <div class="card">
      <text class="card-title">🔍 BLE 扫描</text>
      <text class="data" if="{{scanning}}">正在扫描...</text>
      <text class="data gray" if="{{!scanning && devices.length === 0}}">未开始扫描</text>
      <div for="{{device in devices}}" class="device-item">
        <text class="device-name">{{device.name}}</text>
        <text class="device-addr">{{device.addr}}</text>
        <text class="device-rssi">{{device.rssi}} dBm</text>
      </div>
      <div class="row">
        <input class="btn small" type="button" value="{{scanning ? '停止' : '开始扫描'}}" onclick="toggleScan" />
        <input class="btn small" type="button" value="清空" onclick="clearDevices" />
      </div>
    </div>
    
    <div class="card">
      <text class="card-title">📡 扫描状态</text>
      <text class="data">扫描器状态: {{scanState}}</text>
    </div>
    
    <input class="btn" type="button" value="{{ $t('test.back') }}" onclick="goBack" />
  </div>
</template>

<script>
import router from '@system.router'
import bluetoothBLE from '@system.bluetooth'

export default {
  private: {
    scanning: false,
    devices: [],
    scanState: 'null',
    _scanner: null,
    _subId: null
  },

  goBack() {
    this.cleanup()
    router.back()
  },

  onDestroy() {
    this.cleanup()
  },

  cleanup() {
    if (this._scanner) {
      try {
        if (this._subId !== null) {
          this._scanner.unsubscribeBLEDeviceFind(this._subId)
          this._subId = null
        }
        this._scanner.stopBLEScan()
        this._scanner.close()
      } catch (e) { /* ignore */ }
      this._scanner = null
    }
    this.scanning = false
  },

  toggleScan() {
    if (this.scanning) {
      if (this._scanner) {
        if (this._subId !== null) {
          this._scanner.unsubscribeBLEDeviceFind(this._subId)
          this._subId = null
        }
        this._scanner.stopBLEScan()
        this._scanner.close()
        this._scanner = null
      }
      this.scanning = false
    } else {
      try {
        this._scanner = bluetoothBLE.createScanner()
        this._scanner.getScanState({
          success: (ret) => {
            this.scanState = ret.scanState === 1 ? 'scanning' : 'idle'
          },
          fail: () => { this.scanState = 'fail' }
        })
        this._subId = this._scanner.subscribeBLEDeviceFind({
          callback: (results) => {
            for (const r of results) {
              const exists = this.devices.some(d => d.addr === r.deviceId)
              if (!exists) {
                this.devices.push({
                  name: r.deviceId || 'unknown',
                  addr: r.deviceId,
                  rssi: r.rssi
                })
              }
            }
          },
          fail: () => { console.log('BLE sub fail') }
        })
        this._scanner.startBLEScan({
          filters: [],
          options: { dutyMode: 1 },
          success: () => { this.scanning = true },
          fail: (data, code) => { console.log('BLE scan fail:', code); this.scanning = false }
        })
      } catch (e) {
        console.log('BLE error:', e)
      }
    }
  },

  clearDevices() {
    this.devices = []
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  padding: 10px;
  width: 100%;
}
.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10px;
}
.card {
  flex-direction: column;
  width: 100%;
  background-color: #1e1e1e;
  border-radius: 10px;
  padding: 10px 15px;
  margin-bottom: 8px;
}
.card-title {
  font-size: 14px;
  color: #2196f3;
  margin-bottom: 6px;
}
.data {
  font-size: 16px;
  color: #ffffff;
  margin: 2px 0;
}
.gray { color: #666; }
.row {
  flex-direction: row;
  justify-content: space-around;
  width: 100%;
  margin-top: 6px;
}
.device-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 28px;
  border-top: 1px solid #333;
}
.device-name {
  font-size: 13px;
  color: #4fc3f7;
  flex-grow: 1;
}
.device-addr {
  font-size: 10px;
  color: #888;
  margin: 0 5px;
}
.device-rssi {
  font-size: 11px;
  color: #aaa;
  width: 45px;
  text-align: right;
}
.btn {
  width: 200px;
  height: 40px;
  border-radius: 20px;
  background-color: #007aff;
  font-size: 16px;
  color: #ffffff;
  margin-top: 10px;
}
.small {
  width: 100px;
  height: 32px;
  border-radius: 16px;
  font-size: 12px;
  background-color: #2196f3;
  margin: 0;
}
</style>
