<template>
  <div class="page">
    <text class="page-title">传感器测试</text>
    
    <div class="card">
      <text class="card-title">加速度传感器</text>
      <text class="data" if="{{accelerating}}">X: {{accelX}}</text>
      <text class="data" if="{{accelerating}}">Y: {{accelY}}</text>
      <text class="data" if="{{accelerating}}">Z: {{accelZ}}</text>
      <text class="data gray" if="{{!accelerating}}">未启动</text>
      <block if="{{accelerating}}">
        <input class="btn small" type="button" value="停止" onclick="toggleAccel" />
      </block>
      <block else>
        <input class="btn small" type="button" value="开始" onclick="toggleAccel" />
      </block>
    </div>
    
    <div class="card">
      <text class="card-title">气压/压力传感器</text>
      <text class="data" if="{{hasPressure}}">气压: {{pressure}} hPa</text>
      <text class="data gray" if="{{!hasPressure}}">设备不支持此功能</text>
    </div>
    
    <div class="card">
      <text class="card-title">电子罗盘</text>
      <text class="data" if="{{compassing}}">方向: {{direction}} deg</text>
      <text class="data" if="{{compassing}}">精度: {{compassAcc}}</text>
      <text class="data gray" if="{{!compassing}}">未启动</text>
      <block if="{{compassing}}">
        <input class="btn small" type="button" value="停止" onclick="toggleCompass" />
      </block>
      <block else>
        <input class="btn small" type="button" value="开始" onclick="toggleCompass" />
      </block>
    </div>
    
    <input class="btn" type="button" value="返回" onclick="goBack" />
  </div>
</template>

<script>
import router from '@system.router'
import sensor from '@system.sensor'

export default {
  private: {
    accelerating: false,
    accelX: 0,
    accelY: 0,
    accelZ: 0,
    hasPressure: false,
    pressure: 0,
    compassing: false,
    direction: 0,
    compassAcc: '-'
  },

  goBack() {
    sensor.unsubscribeAccelerometer()
    sensor.unsubscribeCompass()
    sensor.unsubscribePressure()
    router.back()
  },

  onDestroy() {
    sensor.unsubscribeAccelerometer()
    sensor.unsubscribeCompass()
    sensor.unsubscribePressure()
  },

  toggleAccel() {
    if (this.accelerating) {
      sensor.unsubscribeAccelerometer()
      this.accelerating = false
    } else {
      sensor.subscribeAccelerometer({
        interval: 'ui',
        callback: (ret) => {
          this.accelX = ret.x.toFixed(3)
          this.accelY = ret.y.toFixed(3)
          this.accelZ = ret.z.toFixed(3)
          this.accelerating = true
        },
        fail: (data, code) => {
          console.log('Accel fail:', code)
        }
      })
    }
  },

  toggleCompass() {
    if (this.compassing) {
      sensor.unsubscribeCompass()
      this.compassing = false
    } else {
      sensor.subscribeCompass({
        callback: (ret) => {
          this.direction = (ret.direction * 180 / Math.PI).toFixed(1)
          var acc = ret.accuracy
          if (acc === 3) this.compassAcc = 'High'
          else if (acc === 2) this.compassAcc = 'Medium'
          else if (acc === 1) this.compassAcc = 'Low'
          else this.compassAcc = 'Unreliable'
          this.compassing = true
        },
        fail: (data, code) => {
          console.log('Compass fail:', code)
        }
      })
    }
  },

  onInit() {
    sensor.subscribePressure({
      callback: (ret) => {
        this.pressure = ret.pressure.toFixed(1)
        this.hasPressure = true
      },
      fail: function() {
        this.hasPressure = false
      }
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  padding: 10px;
  width: 100%;
}
.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10px;
}
.card {
  flex-direction: column;
  width: 100%;
  background-color: #1e1e1e;
  border-radius: 10px;
  padding: 10px 15px;
  margin-bottom: 8px;
}
.card-title {
  font-size: 14px;
  color: #00bcd4;
  margin-bottom: 6px;
}
.data {
  font-size: 16px;
  color: #ffffff;
  margin: 2px 0;
}
.gray {
  color: #666666;
}
.btn {
  width: 200px;
  height: 40px;
  border-radius: 20px;
  background-color: #007aff;
  font-size: 16px;
  color: #ffffff;
  margin-top: 10px;
}
.small {
  width: 120px;
  height: 32px;
  font-size: 13px;
  margin-top: 6px;
}
</style>
