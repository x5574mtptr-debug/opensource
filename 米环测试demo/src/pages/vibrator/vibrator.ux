.page {
  flex-direction: column;
  align-items: center;
  padding: 10px;
  width: 100%;
}
.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10px;
}
.card {
  flex-direction: column;
  width: 100%;
  background-color: #1e1e1e;
  border-radius: 10px;
  padding: 10px 15px;
  margin-bottom: 8px;
}
.card-title {
  font-size: 14px;
  color: #e91e63;
  margin-bottom: 6px;
}
.data {
  font-size: 16px;
  color: #ffffff;
  margin: 2px 0;
}
.row {
  flex-direction: row;
  justify-content: space-around;
  width: 100%;
  margin: 4px 0;
}
.btn {
  width: 200px;
  height: 40px;
  border-radius: 20px;
  background-color: #007aff;
  font-size: 16px;
  color: #ffffff;
  margin-top: 10px;
}
.small {
  width: 85px;
  height: 32px;
  border-radius: 16px;
  font-size: 12px;
  background-color: #e91e63;
  margin: 3px;
}
.full-w {
  width: 100%;
  background-color: #ff5722;
  margin-top: 6px;
}
</style>
