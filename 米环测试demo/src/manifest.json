{
  "package": "com.demo.bandtester",
  "name": "米环全能测试",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.router" },
    { "name": "system.brightness" },
    { "name": "system.battery" },
    { "name": "system.vibrator" },
    { "name": "system.sensor" },
    { "name": "system.network" },
    { "name": "system.geolocation" },
    { "name": "system.volume" },
    { "name": "system.record" },
    { "name": "system.event" },
    { "name": "system.bluetooth" },
    { "name": "system.zip" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index" },
      "pages/sensor": { "component": "sensor" },
      "pages/system": { "component": "system" },
      "pages/vibrator": { "component": "vibrator" },
      "pages/bluetooth": { "component": "bluetooth" },
      "pages/geo": { "component": "geo" },
      "pages/network": { "component": "network" },
      "pages/recorder": { "component": "recorder" }
    }
  }
}
